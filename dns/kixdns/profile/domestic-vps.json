{
  "version": "1.0",
  "settings": {
    "bind_udp": "0.0.0.0:8844",
    "bind_tcp": "0.0.0.0:8844",
    "default_upstream": "114.114.114.114:53",
    "min_ttl": 30,
    "upstream_timeout_ms": 3000,
    "request_timeout_ms": 7500,
    "response_jump_limit": 10,
    "enable_tcp_fallback": true,
    "udp_pool_size": 128,
    "tcp_pool_size": 64,
    "doh_pool_size": 16,
    "dot_pool_size": 32,
    "doq_pool_size": 16,
    "doq_enable_0rtt": true,
    "cache_capacity": 50000,
    "cache_max_ttl": 86400,
    "cache_background_refresh": true,
    "cache_refresh_threshold_percent": 15,
    "cache_refresh_min_ttl": 10,
    "serve_stale": true,
    "serve_stale_ttl": 30,
    "serve_stale_expire_ttl": 172800,
    "serve_stale_ttl_reset": true,
    "flow_control_enabled": false,
    "flow_control_initial_permits": 500,
    "flow_control_min_permits": 100,
    "flow_control_max_permits": 1200,
    "flow_control_latency_threshold_ms": 150,
    "geoip_dat_path": "/etc/kixdns/geoip.dat",
    "geosite_data_paths": [
      "/etc/kixdns/geosite.dat"
    ]
  },
  "pipeline_select": [
    {
      "pipeline": "blocked",
      "matchers": [
        {
          "type": "geo_site",
          "value": "CATEGORY-ADS-ALL"
        }
      ]
    },
    {
      "pipeline": "default",
      "matchers": [
        {
          "type": "geo_site",
          "value": "CHINA-LIST"
        }
      ]
    },
    {
      "pipeline": "foreign",
      "matchers": [
        {
          "type": "any"
        }
      ]
    }
  ],
  "pipelines": [
    {
      "id": "blocked",
      "rules": [
        {
          "name": "block-ads",
          "matchers": [
            {
              "type": "any"
            }
          ],
          "actions": [
            {
              "type": "log",
              "level": "warn"
            },
            {
              "type": "static_response",
              "rcode": "NXDOMAIN"
            }
          ],
          "response_matchers": [],
          "response_actions_on_match": [],
          "response_actions_on_miss": []
        }
      ]
    },
    {
      "id": "default",
      "rules": [
        {
          "name": "114dns",
          "matchers": [
            {
              "type": "any"
            }
          ],
          "actions": [
            {
              "type": "forward",
              "upstream": "114.114.114.114:53",
              "transport": "udp"
            }
          ],
          "response_matchers": [
            {
              "type": "response_rcode",
              "value": "NOERROR"
            },
            {
              "type": "response_rcode",
              "operator": "or",
              "value": "NXDOMAIN"
            }
          ],
          "response_actions_on_match": [
            {
              "type": "allow"
            }
          ],
          "response_actions_on_miss": [
            {
              "type": "static_response",
              "rcode": "SERVFAIL"
            }
          ]
        },
        {
          "name": "race-doh-dot",
          "matchers": [
            {
              "type": "any"
            }
          ],
          "actions": [
            {
              "type": "log",
              "level": "debug"
            },
            {
              "type": "forward",
              "upstream": [
                "https://dns.alidns.com/dns-query",
                "https://doh.pub/dns-query",
                "dot://dns.alidns.com:853",
                "dot://dot.pub:853",
                "https://dns.tuna.tsinghua.edu.cn/dns-query"
              ]
            }
          ],
          "response_matchers": [
            {
              "type": "response_rcode",
              "value": "NOERROR"
            },
            {
              "type": "response_rcode",
              "operator": "or",
              "value": "NXDOMAIN"
            },
            {
              "type": "response_answer_ip",
              "operator": "not",
              "cidr": "0.0.0.0/8,127.0.0.0/8,169.254.0.0/16"
            }
          ],
          "response_actions_on_match": [
            {
              "type": "allow"
            }
          ],
          "response_actions_on_miss": [
            {
              "type": "continue"
            }
          ]
        }
      ]
    },
    {
      "id": "foreign",
      "rules": [
        {
          "name": "cf+goog",
          "matchers": [
            {
              "type": "any"
            }
          ],
          "actions": [
            {
              "type": "forward",
              "upstream": [
                "8.8.8.8:53",
                "1.1.1.1:53",
                "8.8.4.4:53",
                "1.0.0.1:53"
              ],
              "transport": "udp"
            }
          ],
          "response_matchers": [
            {
              "type": "response_rcode",
              "value": "NOERROR"
            },
            {
              "type": "response_rcode",
              "operator": "or",
              "value": "NXDOMAIN"
            }
          ],
          "response_actions_on_match": [
            {
              "type": "allow"
            }
          ],
          "response_actions_on_miss": [
            {
              "type": "static_response",
              "rcode": "SERVFAIL"
            }
          ]
        },
        {
          "name": "cg-doh",
          "matchers": [
            {
              "type": "any"
            }
          ],
          "actions": [
            {
              "type": "log",
              "level": "debug"
            },
            {
              "type": "forward",
              "upstream": [
                "https://1.1.1.1/dns-query",
                "https://8.8.8.8/dns-query"
              ]
            }
          ],
          "response_matchers": [
            {
              "type": "response_rcode",
              "value": "NOERROR"
            },
            {
              "type": "response_rcode",
              "operator": "or",
              "value": "NXDOMAIN"
            },
            {
              "type": "response_answer_ip",
              "operator": "not",
              "cidr": "0.0.0.0/8,127.0.0.0/8,169.254.0.0/16"
            }
          ],
          "response_actions_on_match": [
            {
              "type": "allow"
            }
          ],
          "response_actions_on_miss": [
            {
              "type": "continue"
            }
          ]
        }
      ]
    }
  ]
}